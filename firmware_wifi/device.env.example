# Registration script writes device-specific MQTT credentials to device.env.
# Do not copy credentials from another sensor.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=/v1/tenants/basis/regions/vostochnoe/fleets/first_pear_nursery/sensors/ultrasonic_weather_station_01/metric
MQTT_CLIENT_ID=esp32-ultrasonic_weather_station_01

# Optional: fill these to bypass the first-boot setup access point.
# Increment WIFI_PROFILE_ID when changing the profile.
# WIFI_PROFILE_ID=indoor-weather-wifi-v1
# WIFI_SSID=
# WIFI_PASSWORD=
# WIFI_SSID_2=
# WIFI_PASSWORD_2=
# WIFI_LATITUDE=55.7558000
# WIFI_LONGITUDE=37.6176000
# WIFI_LATITUDE_2=55.7558000
# WIFI_LONGITUDE_2=37.6176000
